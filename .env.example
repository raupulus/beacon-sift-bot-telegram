# Token del bot obtenido desde @BotFather (NUNCA versionar el token real)
TELEGRAM_BOT_TOKEN=

# Permitir suscripciones en chats privados (en grupos/canales siempre gestionan sus propios admins)
ALLOW_PRIVATE_SUBSCRIPTIONS=false

# Desactivar vista previa de enlaces en las alertas de Telegram (false = muestra tarjeta/imagen del enlace)
TELEGRAM_DISABLE_WEB_PREVIEW=false

# Conexión con el servicio web (feed.raupulus.dev)
WEB_API_BASE_URL=http://127.0.0.1:8000
WEB_API_TIMEOUT_SECONDS=10

# WebSocket público de Laravel Reverb
REVERB_WS_URL=ws://127.0.0.1:8080
REVERB_APP_KEY=beacon-sift-public-key
REVERB_CHANNEL=beacon.news

# Persistencia local SQLite y formato horario
BOT_DB_PATH=data/bot.db
BOT_TIMEZONE=Europe/Madrid
LOG_LEVEL=INFO
